{
  "name": "Notoz: A Privacy Focused Note Taking Web App",
  "short_name": "Notoz",
  "description": "A Web App for secure, encrypted note-taking.",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "display-override": [
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "background_color": "#1c1c1e",
  "theme_color": "#1a1a1a",
  "icons": [
    {
      "src": "src/assets/icons/logo.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "src/assets/icons/logo.png",
      "sizes": "1024x1024",
      "type": "image/png"
    },
    {
      "src": "src/assets/icons/logo.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "src/assets/icons/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "src/assets/icons/logo.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Profile",
      "short_name": "Profile",
      "description": "View your profile",
      "url": "/app/pages/profile"
    },
    {
      "name": "New Note",
      "short_name": "New Note",
      "description": "Create a new note",
      "url": "/app/?action=new-note"
    }
  ]
}