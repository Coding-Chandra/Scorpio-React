{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notoz",
  "version": "2.4.5700",
  "identifier": "notoz.android.rust",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "node scripts/copy-web.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Notoz",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
